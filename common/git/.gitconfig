[push]
    default = simple
    autosetupremote = true
[pull]
    default = current
    ff = only
[merge]
    tool = vimdiff
[alias]
    co = checkout
    ci = commit
    stat = status

    # local branch cleanup, based on https://www.erikschierboom.com/2020/02/17/cleaning-up-local-git-branches-deleted-on-a-remote/
    # gone: prints local branches that no longer have an upstream branch
    gone = ! "git for-each-ref --format '%(refname:short) %(upstream:track)' | awk '$2 == \"[gone]\" {print $1}'"
    # begone: delete local branches that no longer have an upstream branch
    begone = ! "git gone | xargs -r git branch -d"
[core]
    compression = 9
    editor = vim
    excludesFile = ~/git/gitignore_global
[include]
    path = git/user.config
[includeIf "gitdir:~/Documents/work/"]
    ; use work-specific user details for work repositorries
    path = git/user-work.config
[init]
    defaultBranch = master
